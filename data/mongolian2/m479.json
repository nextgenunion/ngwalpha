{
  "id": "m479",
  "title": "Аврагч минь болсон миний Есүс",
  "alternateTitles": [
    "Blessed Assurance Jesus is mine"
  ],
  "artist": "hymn writer Fanny J. Crosby, music written in 1873 by Phoebe P. Knapp., Кнапп, Фоебе П. (1839-1908), Кросбы, Фанны Джане (1820-1915)",
  "key": "C",
  "lyrics": [
    "Аврагч минь [C]болсон [F]миний Е[C]сүс",
    "Ариун [Am]сүнсээр би [D7]дахин төр[G7]сөн",
    "Энэ дэлхийд [C]амьдрах [F]миний [C/E]сүнс",
    "[Am]Тэнгэр дэх [Dm]алдрыг [G7]би эдэл[C]нэ",
    "",
    "  [G7]Энэ бүх зүйл [C]миний [F]итгэлийн [C2/E]түүх",
    "[Cmaj7]Энэ бүх зүйл [F]миний [D7]магтаалын [G]дуу",
    "[G7]Амьдралын [C]туршид [F]Аврагч Э[C]зэнээ",
    "Үүрд мөнхөд [Dm]хүндлэн [G7]магтан дуул[C]на",
    "",
    "Төгс ариун Эзэнд даатгасан",
    "Миний сүнс хайрын дуу хоолойг сонссон",
    "Тэнгэр элчүүдийн аялан явж буй",
    "Тэнгэрийн сүр жавхланг бахдан харна",
    "",
    "Их Эзэний баяр хөөрийг эдлээд",
    "Сэтгэлийн их шуурга намдсан билээ",
    "Энэ дэлхийн амьдрал устан мөхөхөд",
    "Аврагч Их Эзэн харагдана"
  ]
