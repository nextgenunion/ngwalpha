  "id": "m1262",
  "title": "Мөнх бусын энэ орчлон - Ерөөлтэй еэ",
  "alternateTitles": [
    "Үүрдийн гэгээ чуулган"
  ],
  "artist": "",
  "key": "",
  "lyrics": [
    "Мөнх бусын энэхэн хорвоод",
    "Миний амьдрал Таны өмнүүр өнгөрнө",
    "Миний хийсэн гэмийг харахдаа",
    "Та Өөрийн цусаараа угаасан юм",
    "",
    "  Хорвоо дэлхийд Таны хайр ирэхээр",
    "Хүн төрөлхтөн гэмээс ариусгагдана",
    "Миний амьдралд Таны хайр ирэхээр",
    "Бүх зүрхээрээ Таныгаа би хайрлана аа",
    "",
    "Бүхний Дээд Эзэн Таныгаа",
    "Оюун бодолдоо би төсөөлөн суухдаа",
    "Өөрийн амьдралын мөч бүхнээс",
    "Хайр ивээл нигүүслийг тань би хардаг"
  ]
}
