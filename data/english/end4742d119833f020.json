{
  "id": "end4742d119833f020",
  "title": "If I Come to Jesus",
  "lyrics": [
    "Verse 1:",
    "If I come to Jesus,",
    "He will make me glad;",
    "He will give me pleasure",
    "When my heart is sad.",
    "",
    "Chorus 1:",
    "If I come to Jesus,",
    "Happy I shall be.",
    "He is gently calling",
    "Little ones like me.",
    "",
    "Verse 2:",
    "If I come to Jesus",
    "He will hear my prayer;",
    "He will love me dearly,",
    "He my sins did bear.",
    "",
    "Chorus 2:",
    "Refrain",
    "If I come to Jesus",
    "He will take my hand,",
    "He will kindly lead me",
    "To a better land.",
    "",
    "Chorus 3:",
    "Refrain",
    "There with happy children,",
    "Robed in snowy white,",
    "I shall see my Savior",
    "In that world so bright.",
    "",
    "Chorus 4:",
    "Refrain"
  ],
  "artist": "William Howard Doane (1832-1915), Fanny Jane Crosby (1820-1915)"
}
