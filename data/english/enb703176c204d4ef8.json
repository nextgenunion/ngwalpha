  "title": "Blessed be",
  "lyrics": [
    "Chorus 1:",
    "Blessed Be",
    "Blessed Be",
    "Blessed Be Your Name (2x)",
    "",
    "Verse 1:",
    "You, Oh Lord, are a strong and",
    "mighty tower",
    "an ever present help",
    "in my darkest hour",
