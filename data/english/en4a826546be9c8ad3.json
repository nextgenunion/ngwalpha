    "",
    "Verse 3:",
    "Be glorified in me",
    "Be glorified in me",
    "Be glorified in me",
    "Jesus, my King",
    "",
    "Verse 4:",
    "Sacrifice, no words could tell",
    "Majesty on earth to dwell",
    "Living Word, Emmanuel",
    "I'll love you all my days",
    "Maker of the stars above",
    "Praise of angels ever sung",
    "King of Glory, King of Love",
    "Let all creation praise"
  ]
